# Copy to .env and fill in. Never commit .env. Leave keys EMPTY until you have your own.
PORT=4000
NODE_ENV=development
# Public URL of the web app (used for redirects after WHOOP OAuth)
APP_URL=http://localhost:4000
# Extra allowed browser origins (comma separated) — Expo web dev server
CORS_ORIGINS=http://localhost:8081,http://localhost:8082
# 32+ random chars: encrypts third-party tokens at rest AND keys the email-code hashes. REQUIRED in production.
TOKEN_ENC_KEY=

# ---- Email verification codes (required in production; in development codes are shown in the server log)
# Option A — Resend (https://resend.com): create an API key and verify your sending domain
RESEND_API_KEY=
# Option B — any SMTP server, e.g. smtps://USER:PASSWORD@smtp.example.com:465
SMTP_URL=
# Force a provider: resend | smtp | none (default: whichever of the two above is filled in)
MAIL_PROVIDER=
# Sender shown to users, e.g. Astra <no-reply@yourdomain.com>. The domain must be verified with your provider.
MAIL_FROM=

# ---- AI helper (optional; without a key the helper answers offline from your own data and the cited rules)
ANTHROPIC_API_KEY=
ASTRA_AI_MODEL=

# ---- WHOOP developer app — https://developer-dashboard.whoop.com/
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:4000/api/integrations/whoop/callback
# Native deep link the app listens on after OAuth
NATIVE_REDIRECT=perigee://integrations
